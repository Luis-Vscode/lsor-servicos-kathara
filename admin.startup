ip addr add 10.10.2.10/24 dev eth0
ip link set eth0 up
ip route add default via 10.10.2.1

mkdir -p /root/.ssh
chmod 700 /root/.ssh
rm -f /root/.ssh/id_ed25519 /root/.ssh/id_ed25519.pub /shared/admin.pub
ssh-keygen -t ed25519 -N "" -C "admin@lan" -f /root/.ssh/id_ed25519 >/dev/null
cp /root/.ssh/id_ed25519.pub /shared/admin.pub.tmp
mv /shared/admin.pub.tmp /shared/admin.pub
